# Database Configuration
DB_CONNECTION_STRING=postgresql://postgres:your_password_here@localhost:5432/bonsai
DB_POOL_SIZE=10
DB_SSL=true

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (e.g. http://localhost:5173,https://console.example.com).
# When unset, every request's origin is echoed back (credentials-compatible — works with
# fetch credentials:'include' from any localhost dev server). Set it in production to lock
# the API down to your console origin(s).
#CORS_ORIGIN=
