# Database Configuration
DB_CONNECTION_STRING=postgresql://postgres:your_password_here@localhost:5432/bonsai
DB_POOL_SIZE=10
DB_SSL=true

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars

# Server Configuration
PORT=3000
NODE_ENV=development

# URL of the application, used for toll call webhook callback
APP_URL=http://localhost:3000
