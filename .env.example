# Database Configuration
DB_CONNECTION_STRING=postgresql://postgres:your_password_here@localhost:5432/bonsai
DB_POOL_SIZE=10
DB_SSL=true

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (e.g. http://localhost:5173,https://console.example.com).
# When unset, every request's origin is echoed back (credentials-compatible — works with
# fetch credentials:'include' from any localhost dev server). Set it in production to lock
# the API down to your console origin(s).
#CORS_ORIGIN=

# Prometheus scrape endpoint (P4-01). When unset/empty, GET /metrics returns 404 (disabled).
# Set to a long random string to enable; scrape with header: Authorization: Bearer <token>
#MONITORING_METRICS_TOKEN=

# Monitoring
# HealthCheckService cycle in ms. Default: 60000 (min 1000; invalid values fall back).
#MONITORING_HEALTH_INTERVAL_MS=60000
# LLM/ASR/TTS liveness probes. "off" is a hard kill switch (env wins over config).
# Default: on
#MONITORING_HEALTH_PROBES=on
# AlertRuleEngine tick in ms. Overrides the config's engineIntervalMinutes for the whole
# process. Default: unset (uses config, 1 minute; min 1000)
#MONITORING_ALERT_ENGINE_INTERVAL_MS=
# CallLogger in-memory buffer cap before overflow drops the oldest entries.
# Default: 10000
#MONITORING_CALL_LOG_BUFFER_SIZE=10000
# RSS threshold in MB for the high-memory health check / alert.
# Default: 1536
#MONITORING_MEMORY_THRESHOLD_MB=1536
# First-boot env fallbacks (used only to seed the initial monitoring_config row;
# after that the DB row wins — edit via PUT /api/monitoring/config).
# Webhook notifier URL (http(s))
#MONITORING_WEBHOOK_URL=
# Email notifier (both required together): channel provider id + recipient address
#MONITORING_EMAIL_PROVIDER_ID=
#MONITORING_EMAIL_TO=
# Retention in days for call logs / health checks / metric samples (stats: 2x).
# Integer >= 7. Default: 90
#MONITORING_RETENTION_DAYS=90

# Graceful shutdown
# Max ms to drain WebSocket/voice connections before force-terminating stragglers.
# Default: 10000
#SHUTDOWN_GRACE_MS=10000
