# PostgreSQL password for the bonsai database user.
# Default: bonsai (change in production)
POSTGRES_PASSWORD=bonsai-skjgksajhgajfdhg-secret

# JWT secret used by bonsai-backend to sign and verify tokens.
# REQUIRED. Must be at least 32 characters long.
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Runtime environment. Use "production" for production deployments.
NODE_ENV=production

# Host port on which the backend API is exposed.
# Default: 3000
BACKEND_PORT=3000

# Host port on which the admin panel is exposed.
# Default: 80
ADMIN_PORT=80

# Host port on which the backend API documentation is exposed.
# Default: 8080
DOCS_PORT=8080

# Allowed CORS origin for the backend.
# Set to a specific domain in production (e.g., https://admin.example.com).
# Default: * (all origins)
CORS_ORIGIN=*

# Whether to trust the X-Forwarded-For header set by a reverse proxy.
# Set to "false" only if the backend is directly exposed to the internet without a proxy.
# Default: true (enabled)
#TRUST_PROXY=false

# Database connection pool size.
# Default: 10
DB_POOL_SIZE=10

# Log level for the backend: trace, debug, info, warn, error, fatal.
# Default: info
LOG_LEVEL=info

# Rate limiting for authentication endpoints (POST /api/auth/login, POST /api/auth/refresh).
# Window in milliseconds and max requests per IP within that window.
# Default: 10 attempts per 15 minutes
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# Rate limiting for the general API.
# Window in milliseconds and max requests per authenticated operator (or IP if unauthenticated).
# Default: 300 requests per minute
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300

# Rate limiting for WebSocket authentication attempts (auth message per IP address).
# Window in milliseconds and max attempts per IP within that window.
# Default: 10 attempts per 15 minutes
RATE_LIMIT_WS_AUTH_WINDOW_MS=900000
RATE_LIMIT_WS_AUTH_MAX=10

# Master encryption key for the local secrets manager.
# Used to encrypt/decrypt provider API keys and other sensitive credentials stored in the database.
# REQUIRED when the local secrets manager is enabled.
# Generate with: openssl rand -hex 32
# Must be a 64-char hex string (32 bytes) or a 44-char base64 string.
MASTER_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Prometheus scrape endpoint (P4-01). When unset/empty, GET /metrics returns 404 (disabled).
# Set to a long random string to enable; scrape with header: Authorization: Bearer <token>
#MONITORING_METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

# HealthCheckService cycle in milliseconds (db pool, process, background-service
# heartbeats, provider probes). Minimum 1000; invalid values fall back to the default.
# Default: 60000
#MONITORING_HEALTH_INTERVAL_MS=60000

# LLM/ASR/TTS liveness probes (cheap enumerate/ping endpoints). "off" is a hard
# environment kill switch that overrides any config setting.
# Default: on (unset)
#MONITORING_HEALTH_PROBES=on

# AlertRuleEngine tick in milliseconds. Overrides the monitoring config's
# engineIntervalMinutes for the whole process. Minimum 1000.
# Default: unset (uses the config value, 1 minute)
#MONITORING_ALERT_ENGINE_INTERVAL_MS=

# In-memory CallLogger buffer cap (rows) before overflow drops the oldest entries.
# Raise if you see "buffer overflow" warnings under bursty load.
# Default: 10000
#MONITORING_CALL_LOG_BUFFER_SIZE=10000

# RSS threshold in MB for the high-memory health check and alert rule.
# Default: 1536
#MONITORING_MEMORY_THRESHOLD_MB=1536

# First-boot env fallbacks — used ONLY to seed the initial monitoring_config row.
# After first boot the DB row wins; edit via PUT /api/monitoring/config (super_admin).

# Webhook alert notifier URL (http(s))
#MONITORING_WEBHOOK_URL=

# Email alert notifier — both are required together; the channel provider must be an
# email-type provider configured in the database.
#MONITORING_EMAIL_PROVIDER_ID=
#MONITORING_EMAIL_TO=

# Retention in days for provider_call_logs, health_checks, metric_samples
# (provider_call_stats_hourly is kept for 2x). Integer >= 7.
# Default: 90
#MONITORING_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Graceful shutdown
# ---------------------------------------------------------------------------

# Maximum time in milliseconds to drain WebSocket/voice connections on SIGTERM/SIGINT
# before force-terminating stragglers.
# Default: 10000
#SHUTDOWN_GRACE_MS=10000
